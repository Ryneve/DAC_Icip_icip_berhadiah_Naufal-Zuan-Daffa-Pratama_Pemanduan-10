}

def hitung_indeks(bobot):
    w = np.array(bobot, dtype=float)
    return(peringkat * w).sum(axis=1) /w.sum() * 100

def top_5_per_komoditas(indeks):
    # himpunan yang terdiri dari komoditas dan provinsi, diambil 5 teratas di tiap komoditas
    hasil = set()
    for _, sub in indeks.groupby(level="komoditas"):
        hasil |= set(sub.nlargest(5).index)
        
    return hasil

