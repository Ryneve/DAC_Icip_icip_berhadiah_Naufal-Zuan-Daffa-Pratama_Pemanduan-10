def rapikan_teks(seri):
    return seri.str.strip().str.replace(r"\s+", " ", regex = True).str.lower()

def normalisasi_bulan(nilai):
    if pd.isna(nilai):
        return None
    nilai = str(nilai).strip()
    for fmt in format_tanggal:
        try:
            return datetime.strptime(nilai,fmt).strftime("%Y-%m")
        except ValueError:
            continue
    return None

def ubah_angka(nilai,rupiah =False):
    
    if pd.isna(nilai):
        return float("nan")
    
    s = re.sub(r"(?i)rp|%|\s", "", str(nilai))
    if s.lower() in tanpa_nilai:
        return float("nan")
    
    if "." in s and "," in s:
        if s.rfind(",") > s.rfind("."):    #1.234,56(format indonesia)
            
            s = s.replace(".", "").replace(",", ".")
            
        else:
            
            s = s.replace(",", "")
    elif rupiah and re.fullmatch(r"\d{1,3}(\.\d{3})+", s):
        
        s = s.replace(".", "")
        
    elif rupiah and re.fullmatch(r"\d{1,3}(\,\d{3})+", s):
        
        s = s.replace(",","")
        
    elif "," in s:
        s = s.replace(",", ".")
        
    return pd.to_numeric(s, errors ="coerce")

def isi_per_grup(data,kolom,grup):
    
    jumlah_unik = data.groupby(grup)[kolom].nunique()
    if(jumlah_unik > 1).any():
        print(f"Peringatan : {kolom} tidak konsiten di {(jumlah_unik > 1).sum()} grup '{grup}'"
              "(diisi dengan median grup)")
    return data[kolom].fillna(data.groupby(grup)[kolom].transform("median"))

def simpan_tabel(tabel,nama, index= True):
    tabel.to_csv(folder_output / nama, index = index, encoding ="utf-8-sig") 

        
def simpan_grafik(nama_file):
    
