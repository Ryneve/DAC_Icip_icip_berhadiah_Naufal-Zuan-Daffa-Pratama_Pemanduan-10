def label_bulan (ax, bulan, langkah=3):
    ax.set_xticks(range(0,len(bulan),langkah))
    ax.set_xticklabels(list(bulan[::langkah]), rotation = 45, ha="right")
        
def indeks_awal(seri):
    # ubah seri menjadi sebuah indeks, nilai valid pertama = 100.
    valid = seri.dropna()
    return seri / valid.iloc[0] *100 if len(valid) else seri

